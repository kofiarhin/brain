MONGODB_URI=
PORT=5000
CLIENT_URL=http://localhost:5173
AUTH_USERNAME=
AUTH_PASSWORD=
JWT_SECRET=

# Client-only, required only when the frontend is deployed separately from the API.
# For local dev this is optional because Vite proxies /api to http://localhost:5000.
# VITE_API_URL=https://YOUR_HEROKU_APP.herokuapp.com/api
NVIDIA_AI_ENABLED=true
NVIDIA_VECTOR_SEARCH_ENABLED=true
NVIDIA_RERANK_ENABLED=true
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com
NVIDIA_CHAT_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2
NVIDIA_RERANK_MODEL=nvidia/llama-3.2-nv-rerankqa-1b-v2
NVIDIA_EMBEDDING_DIMENSIONS=2048
NVIDIA_VECTOR_INDEX=note_embedding_vector_index
NVIDIA_REQUEST_TIMEOUT_MS=30000
NVIDIA_MAX_RETRIES=2
AI_QUESTION_LIMIT_PER_MINUTE=5
AI_VECTOR_CANDIDATES=20
AI_RERANKED_RESULTS=5
AI_MAX_CONTEXT_CHARS=18000
AI_MAX_ANSWER_TOKENS=700
AI_BACKFILL_BATCH_SIZE=10
