# ---------------------------------------------------------------------------
# Brain OS server configuration
#
# Copy to .env and fill in real values. NEVER commit a populated .env.
# Every value here is a placeholder or a safe default — no real credentials.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
MONGODB_URI=
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# --- Authentication --------------------------------------------------------
AUTH_USERNAME=
AUTH_PASSWORD=
# Required. Must be >= 32 characters in production; well-known placeholders
# ("secret", "changeme", ...) are rejected at startup. There is no built-in
# fallback secret.
JWT_SECRET=
# Access-token lifetime. Accepts 3600, 30s, 15m, 1h, 7d.
# Default when unset: 12h. Recommended hardened production value: 1h.
# There is no refresh-token flow, so a shorter value means more frequent logins.
JWT_EXPIRES_IN=1h

# --- API hardening ---------------------------------------------------------
# Comma-separated exact origins allowed by CORS. This is the recommended way to
# configure production; CLIENT_URL is also always allowed.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# When true, ONLY CORS_ALLOWED_ORIGINS and CLIENT_URL are accepted. Leave false
# to keep the legacy brain-*.vercel.app preview patterns working. Those patterns
# match any such hostname, which this project does not exclusively control —
# set this to true in production.
CORS_STRICT_ORIGINS=false
# Maximum accepted JSON / urlencoded request body.
REQUEST_BODY_LIMIT=1mb
# Proxy trust. Only false / true / a hop count are honoured; any other string
# resolves to false. Set to 1 behind a single proxy such as Heroku, otherwise
# X-Forwarded-For is ignored and rate limiting uses the socket address.
TRUST_PROXY=false
# Set to false only if the served frontend needs inline scripts.
SECURITY_CSP_ENABLED=true

# --- Logging ---------------------------------------------------------------
# debug | info | warn | error. Defaults to info (error while testing).
LOG_LEVEL=info

# --- Authentication rate limiting -----------------------------------------
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Attempts per identity, per IP, per window.
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
# Ceiling on all attempts from one IP, so rotating usernames cannot bypass the
# per-identity limit.
AUTH_RATE_LIMIT_MAX_PER_IP=20
# memory | upstash
AUTH_RATE_LIMIT_STORE=memory

# --- Chat rate limiting ----------------------------------------------------
CHAT_RATE_LIMIT_WINDOW_MS=60000
# Falls back to AI_QUESTION_LIMIT_PER_MINUTE when unset.
CHAT_RATE_LIMIT_MAX_REQUESTS=5
# memory | upstash
CHAT_RATE_LIMIT_STORE=memory
# Upper bound on tracked keys per store (memory-growth guard).
RATE_LIMIT_MAX_KEYS=10000

# Required only when either rate-limit store is set to upstash. Server-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# IMPORTANT: the "memory" store is per-process. It CANNOT enforce a shared limit
# across multiple Heroku dynos or application instances, and it resets on every
# restart. Use the Upstash adapter before scaling out. If Upstash cannot initialise,
# readiness reports degraded mode and the process falls back to bounded memory.

# --- Embedding queue -------------------------------------------------------
# in-process | <a registered durable adapter name>
EMBEDDING_QUEUE_DRIVER=in-process
EMBEDDING_QUEUE_CONCURRENCY=2
EMBEDDING_QUEUE_MAX_QUEUED=500
EMBEDDING_JOB_MAX_ATTEMPTS=3

# IMPORTANT: the "in-process" queue is NOT durable. Queued embedding work is lost
# on restart, crash, or dyno cycling. Notes are never lost — they persist before
# the job is enqueued — and lost work is recoverable with:
#   npm run brain:backfill-embeddings

# --- NVIDIA AI -------------------------------------------------------------
NVIDIA_AI_ENABLED=true
NVIDIA_VECTOR_SEARCH_ENABLED=true
NVIDIA_RERANK_ENABLED=true
# Server-only. NEVER prefix with VITE_ — that would ship it in the browser bundle.
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com
# Reranking is NOT on the host above: it is served from the retrieval host, where
# each model has its own route. The client derives that route from the model name.
NVIDIA_RERANK_BASE_URL=https://ai.api.nvidia.com
NVIDIA_CHAT_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
# nvidia/llama-3.2-nv-rerankqa-1b-v2 is retired and now answers 410.
NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2
# Must equal the numDimensions of the Atlas vector index AND the dimensions the
# embedding model actually returns. A mismatch is rejected, not silently stored.
NVIDIA_EMBEDDING_DIMENSIONS=2048
NVIDIA_VECTOR_INDEX=note_embedding_vector_index
NVIDIA_REQUEST_TIMEOUT_MS=30000
# Counts RETRIES, not attempts: 0 = one attempt with no retries, 2 = up to three
# attempts. Valid range 0-5. Decimals, negatives, empty and non-numeric values
# fall back to 2 rather than producing NaN.
NVIDIA_MAX_RETRIES=2

# --- AI budgets ------------------------------------------------------------
AI_QUESTION_LIMIT_PER_MINUTE=5
AI_VECTOR_CANDIDATES=20
AI_RERANKED_RESULTS=5
AI_MAX_CONTEXT_CHARS=18000
AI_MAX_ANSWER_TOKENS=700
AI_BACKFILL_BATCH_SIZE=10

# --- Opt-in live smoke test (never used by CI) -----------------------------
# Must be exactly "true" to run. Refuses to run when NODE_ENV=production.
RUN_NVIDIA_SMOKE_TEST=false
# REQUIRED for the smoke test. Must be a NON-PRODUCTION database and must differ
# from MONGODB_URI.
SMOKE_TEST_MONGODB_URI=

# --- Client (only when the frontend is deployed separately from the API) ---
# For local dev this is optional: Vite proxies /api to http://localhost:5000.
# VITE_API_URL=https://YOUR_HEROKU_APP.herokuapp.com/api
